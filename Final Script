    "def get_lr(epoch):\n",
    "    epochs = [0, 15, 35, 70, 130]\n",
    "    lrs = [0.0010, 0.0005, 0.0001, 0.00001, 0.00001]\n",
    "    return np.interp(epoch, epochs, lrs)\n",
