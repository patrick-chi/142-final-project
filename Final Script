    "def get_l2(epoch):\n",
    "    epochs = [0, 50, 70, 85, 130]\n",
    "    l2s = [1e-5, 1e-5, 1e-6, 1e-7, 1e-7]\n",
    "    return np.interp(epoch, epochs, l2s)\n",
