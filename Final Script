    "class ConfigurableAtomicNet(nn.Module):\n",
    "    def __init__(self, hidden_layers=[128, 64], dropout_rate=0.1):\n",
    "        super().__init__()\n",
    "        layers = []\n",
    "        input_dim = 384\n",
    "        \n",
    "        for hidden_dim in hidden_layers:\n",
    "            layers.append(nn.Linear(input_dim, hidden_dim))\n",
    "            layers.append(nn.ReLU())\n",
    "            if dropout_rate > 0.0:\n",
    "                layers.append(nn.Dropout(dropout_rate))\n",
    "            input_dim = hidden_dim\n",
    "            \n",
    "        layers.append(nn.Linear(input_dim, 1))\n",
    "        self.layers = nn.Sequential(*layers)\n",
    "        \n",
    "    def forward(self, x):\n",
    "        return self.layers(x)\n",
    "\n",
    "def get_configurable_model(hidden_layers, dropout_rate):\n",
    "    net_H = ConfigurableAtomicNet(hidden_layers, dropout_rate)\n",
    "    net_C = ConfigurableAtomicNet(hidden_layers, dropout_rate)\n",
    "    net_N = ConfigurableAtomicNet(hidden_layers, dropout_rate)\n",
    "    net_O = ConfigurableAtomicNet(hidden_layers, dropout_rate)\n",
    "\n",
    "    ani_net = torchani.ANIModel([net_H, net_C, net_N, net_O])\n",
    "    model = nn.Sequential(aev_computer, ani_net).to(device)\n",
    "    return model\n",
    "\n",
    "def evaluate_mae(model, data_loader):\n",
    "    model.eval()\n",
    "    total_mae = 0.0\n",
    "    total_items = 0\n",
    "    hartree2kcalmol = 627.5094738898777\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for batch in data_loader:\n",
    "            species = batch['species'].to(device)\n",
    "            coords = batch['coordinates'].to(device)\n",
    "            true_energies = batch['energies'].to(device).float()\n",
    "            \n",
    "            _, pred_energies = model((species, coords))\n",
    "            mae = torch.abs(true_energies - pred_energies).sum().item()\n",
    "            \n",
    "            total_mae += mae\n",
    "            total_items += species.shape[0]\n",
    "            \n",
    "    return (total_mae / total_items) * hartree2kcalmol\n",
    "\n",
