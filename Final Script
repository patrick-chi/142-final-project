    "combinations_to_test = [\n",
    "    {'hidden_layers': [128, 64], 'learning_rate': 5e-4, 'epochs': 30, 'l2_weight_decay': 1e-6, 'dropout_rate': 0.1},\n",
    "    {'hidden_layers': [128, 64], 'learning_rate': 5e-4, 'epochs': 70, 'l2_weight_decay': 1e-6, 'dropout_rate': 0.1},\n",
    "    {'hidden_layers': [128, 64], 'learning_rate': 5e-4, 'epochs': 50, 'l2_weight_decay': 1e-6, 'dropout_rate': 0.0},\n",
    "    {'hidden_layers': [160, 128], 'learning_rate': 5e-4, 'epochs': 50, 'l2_weight_decay': 1e-6, 'dropout_rate': 0.05},\n",
    "    {'hidden_layers': [128, 64, 32], 'learning_rate': 5e-4, 'epochs': 50, 'l2_weight_decay': 1e-6, 'dropout_rate': 0.05},\n",
    "    {'hidden_layers': [128, 64], 'learning_rate': 1e-4, 'epochs': 100, 'l2_weight_decay': 1e-7, 'dropout_rate': 0.0}\n",
    "]\n",
    "\n",
    "print(f\"\\nStarting Search: Testing {len(combinations_to_test)} targeted configurations...\\n\")\n",
    "\n",
    "for i, params in enumerate(combinations_to_test):\n",
    "    print(\"-\" * 50)\n",
    "    print(f\"Model {i+1}/{len(combinations_to_test)} Configuration:\")\n",
    "    for k, v in params.items():\n",
    "        print(f\"  {k}: {v}\")\n",
    "    \n",
    "    current_model = get_configurable_model(params['hidden_layers'], params['dropout_rate'])\n",
    "    \n",
    "    trainer = ANITrainer(\n",
    "        model=current_model, \n",
    "        batch_size=tuning_batch_size, \n",
    "        learning_rate=params['learning_rate'], \n",
    "        epoch=params['epochs'], \n",
    "        l2=params['l2_weight_decay']\n",
    "    )\n",
    "    \n",
    "    trainer.train(train_tuning_data, val_tuning_data, early_stop=True, draw_curve=False)\n",
    "    \n",
    "    train_mae = evaluate_mae(current_model, train_loader)\n",
    "    val_mae = evaluate_mae(current_model, val_loader)\n",
    "    test_mae = evaluate_mae(current_model, test_loader)\n",
    "    \n",
    "    print(f\"\\nResults for Model {i+1}:\")\n",
    "    print(f\"  Train MAE: {train_mae:.4f} kcal/mol\")\n",
    "    print(f\"  Val MAE:   {val_mae:.4f} kcal/mol\")\n",
    "    print(f\"  Test MAE:  {test_mae:.4f} kcal/mol\")"
